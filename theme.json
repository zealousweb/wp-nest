{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"useRootPaddingAwareAlignments": true,
		"appearanceTools": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "primary",
					"color": "var(--color-primary)",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "var(--color-secondary)",
					"name": "Secondary"
				},
				{
					"slug": "white",
					"color": "var(--color-white, #ffffff)",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "var(--color-black, #000000)",
					"name": "Black"
				},
				{
					"slug": "gray-200",
					"color": "var(--color-gray-200)",
					"name": "Gray 200"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "var(--font-sans)"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "var(--font-serif)"
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "XS",
					"size": "var(--text-xs, 0.75rem)"
				},
				{
					"slug": "sm",
					"name": "SM",
					"size": "var(--text-sm, 0.875rem)"
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "var(--text-base, 1rem)"
				},
				{
					"slug": "lg",
					"name": "LG",
					"size": "var(--text-lg, 1.125rem)"
				},
				{
					"slug": "xl",
					"name": "XL",
					"size": "var(--text-xl, 1.25rem)"
				},
				{
					"slug": "2xl",
					"name": "2XL",
					"size": "var(--text-2xl, 1.5rem)"
				},
				{
					"slug": "3xl",
					"name": "3XL",
					"size": "var(--text-3xl, 1.875rem)"
				},
				{
					"slug": "4xl",
					"name": "4XL",
					"size": "var(--text-4xl, 2.25rem)"
				},
				{
					"slug": "5xl",
					"name": "5XL",
					"size": "var(--text-5xl, 3rem)"
				}
			]
		},
		"spacing": {
			"blockGap": false,
			"margin": false,
			"padding": false,
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		},
		"layout": {
			"contentSize": "var(--width-container, 1170px)",
			"wideSize": "1400px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--color-white, #ffffff)",
			"text": "var(--color-black, #000000)"
		},
		"typography": {
			"fontFamily": "var(--font-sans)",
			"fontSize": "var(--text-base)",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--color-primary)"
				},
				":hover": {
					"color": {
						"text": "var(--color-secondary)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--text-5xl)"
				},
				"color": {
					"text": "var(--color-primary)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--text-4xl)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--text-3xl)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--text-2xl)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--text-xl)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--text-lg)"
				}
			}
		}
	}
}
