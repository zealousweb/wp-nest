{
	"name": "wpnest",
	"version": "1.0.2",
	"engines": {
		"node": "24.15.0"
	},
	"private": true,
	"description": "A starter theme for WordPress with modern JavaScript and CSS tooling.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint:js": "eslint -c config/config.eslint.js \"sources/**/*.js\"",
		"lint:js:fix": "eslint -c config/config.eslint.js \"sources/**/*.js\" --fix",
		"lint:css": "stylelint -c config/config.stylelint.js \"sources/**/*.css\"",
		"lint:css:fix": "stylelint -c config/config.stylelint.js \"sources/**/*.css\" --fix",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
		"phpcs": "vendor/bin/phpcs",
		"phpcbf": "vendor/bin/phpcbf"
	},
	"keywords": [
		"WordPress",
		"theme",
		"starter",
		"vite",
		"sass"
	],
	"author": "admin",
	"license": "ISC",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"esbuild": "0.28.1",
		"eslint": "10.6.0",
		"glob": "13.0.6",
		"globals": "17.7.0",
		"husky": "9.1.7",
		"lint-staged": "17.0.8",
		"svgo": "3.3.2",
		"terser": "5.48.0",
		"vite": "8.1.3",
		"vite-plugin-checker": "0.14.4",
		"vite-plugin-image-optimizer": "^1.1.8",
		"vite-plugin-live-reload": "3.1.0"
	},
	"dependencies": {
		"@fancyapps/ui": "6.1.14",
		"@tailwindcss/vite": "^4.3.3",
		"cspell": "10.0.1",
		"swiper": "14.0.1",
		"tailwindcss": "^4.3.3"
	},
	"lint-staged": {
		"sources/**/*.js": [
			"eslint -c config/config.eslint.js --fix"
		],
		"sources/**/*.css": [
			"stylelint -c config/config.stylelint.js --fix"
		],
		"*.php": [
			"vendor/bin/phpcbf",
			"vendor/bin/phpcs"
		]
	}
}
