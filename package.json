{
	"name": "wpnest",
	"version": "1.0.2",
	"engines": {
		"node": "24.15.0"
	},
	"private": true,
	"description": "A starter theme for WordPress with modern JavaScript and CSS tooling.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"format": "prettier --write \"**/*.{js,css,json,md,php}\"",
		"format:check": "prettier --check \"**/*.{js,css,json,md,php}\"",
		"prepare": "husky"
	},
	"keywords": [
		"WordPress",
		"theme",
		"starter",
		"vite",
		"tailwindcss"
	],
	"author": "admin",
	"license": "ISC",
	"devDependencies": {
		"@prettier/plugin-php": "0.22.2",
		"esbuild": "0.28.1",
		"glob": "13.0.6",
		"globals": "17.7.0",
		"husky": "9.1.7",
		"lint-staged": "17.0.8",
		"prettier": "3.5.3",
		"svgo": "3.3.2",
		"terser": "5.48.0",
		"vite": "8.1.3",
		"vite-plugin-checker": "0.14.4",
		"vite-plugin-image-optimizer": "1.1.8",
		"vite-plugin-live-reload": "3.1.0"
	},
	"dependencies": {
		"@fancyapps/ui": "6.1.14",
		"@tailwindcss/vite": "4.3.3",
		"cspell": "10.0.1",
		"swiper": "14.0.1",
		"tailwindcss": "4.3.3"
	},
	"lint-staged": {
		"**/*.{js,css,json,md,php}": [
			"prettier --write"
		]
	}
}
